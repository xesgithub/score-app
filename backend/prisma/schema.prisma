// Prisma schema — score-app Demo01
// DB: SQLite (สลับเป็น PostgreSQL ได้โดยเปลี่ยน provider + DATABASE_URL)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Competition {
  id          String   @id @default(cuid())
  name        String
  description String?
  eventDate   DateTime?
  status      String   @default("draft") // draft | open | closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criteria    Criterion[]
  competitors Competitor[]
  judges      Judge[]
  activityLogs ActivityLog[]
}

model Criterion {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  weightPercent Float    // น้ำหนัก % — รวมทุกหัวข้อในการแข่งขัน = 100
  maxScore      Float    @default(5)
  displayOrder  Int      @default(0)

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  scores        Score[]
}

model Competitor {
  id            String   @id @default(cuid())
  competitionId String
  name          String   // ชื่อบุคคลหรือชื่อทีม (นับเป็น 1 entry)
  bibNumber     String?
  note          String?
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  scores        Score[]
  teamLocks     TeamLock[]
}

model Judge {
  id            String   @id @default(cuid())
  competitionId String
  label         String   // เช่น "กรรมการ 1"
  accessToken   String   @unique
  tokenRevoked  Boolean  @default(false)
  scoresLockedAt DateTime?  // null = ยังแก้คะแนนได้, มีค่า = กรรมการยืนยัน/ล็อกแล้ว
  createdAt     DateTime @default(now())

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  scores        Score[]
  teamLocks     TeamLock[]
}

model Score {
  id           String   @id @default(cuid())
  judgeId      String
  competitorId String
  criterionId  String
  value        Float    // 0.00 - 5.00
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  judge        Judge      @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  criterion    Criterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([judgeId, competitorId, criterionId])
}

model ActivityLog {
  id            String   @id @default(cuid())
  competitionId String
  actorType     String   // "admin" | "judge" | "system"
  actorLabel    String   // snapshot ณ เวลานั้น เช่น "Admin", "กรรมการ 1"
  actorJudgeId  String?  // ถ้าเป็น judge เก็บ id ไว้ filter (กรรมการเห็นเฉพาะของตัวเอง)
  action        String   // เช่น "score.set", "competition.status", "score.lock"
  detail        String?  // ข้อความไทยพร้อมแสดง
  metadata      String?  // JSON string (before/after ฯลฯ) — optional
  createdAt     DateTime @default(now())

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, createdAt])
  @@index([actorJudgeId])
}

// ล็อกคะแนนราย "ทีม" ต่อกรรมการ — กันกดผิดระหว่างกรอก (กรรมการล็อกทีมของตัวเอง)
model TeamLock {
  id           String   @id @default(cuid())
  judgeId      String
  competitorId String
  lockedAt     DateTime @default(now())

  judge        Judge      @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([judgeId, competitorId])
}
